{
	"name": "upi",
	"version": "0.1.0",
	"description": "Pi, the coding agent, compiled ahead of time to native code: one executable for Linux x86-64 and ARM64 (Android too, in Termux), macOS on Apple silicon and Windows x64, starts 2-3x sooner than Pi on Bun and uses about a third of its CPU over a session",
	"keywords": [
		"pi",
		"coding-agent",
		"ai",
		"cli",
		"aot",
		"bun"
	],
	"homepage": "https://github.com/Code000-211/microPi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Code000-211/microPi.git",
		"directory": "npm"
	},
	"bugs": "https://github.com/Code000-211/microPi/issues",
	"license": "MIT",
	"author": "OpenSec",
	"bin": {
		"upi": "bin/upi.exe"
	},
	"files": [
		"bin/upi",
		"bin/upi.exe",
		"install.cjs",
		"install.sh",
		"README.md"
	],
	"os": [
		"linux",
		"android",
		"darwin",
		"win32"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"scripts": {
		"prepack": "node -e \"require('fs').copyFileSync('../install.sh', 'install.sh')\"",
		"postinstall": "node install.cjs"
	}
}
